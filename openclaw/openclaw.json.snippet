{
  "plugins": {
    "entries": {
      "hindsight-openclaw": {
        "enabled": true,
        "hooks": { "allowConversationAccess": true },
        "config": {
          "hindsightApiUrl": "https://api.hindsight.vectorize.io",
          "dynamicBankId": false,
          "bankId": "acorn-demo-pager",
          "memoryMode": "hybrid",
          "autoRetain": false
        }
      }
    }
  }
}
